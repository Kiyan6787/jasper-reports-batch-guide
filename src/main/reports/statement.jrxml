<?xml version="1.0" encoding="UTF-8"?>
<!-- JasperReports 7 JRXML format. Compiled to statement.jasper at build time. -->
<jasperReport name="AccountStatement" language="java"
              pageWidth="595" pageHeight="842" columnWidth="523"
              leftMargin="36" rightMargin="36" topMargin="36" bottomMargin="36"
              whenNoDataType="AllSectionsNoDetail">

  <!-- Per-tenant Brand.* styles arrive at fill time as a JRTemplate object.
       No class attribute: JRXML 7 reads <template> as plain text, and an
       attribute turns it into an object node, silently emptying the expression. -->
  <template><![CDATA[$P{BRAND_TEMPLATE}]]></template>

  <!-- ========================= Local styles ========================= -->
  <style name="Base" default="true" fontName="DejaVu Sans" fontSize="8.0"
         forecolor="#1F2933"/>
  <style name="Muted" style="Base" fontSize="7.0" forecolor="#5F6B7A"/>
  <style name="Figure" style="Base" fontSize="11.0" bold="true" hTextAlign="Right"/>
  <style name="Cell" style="Base" vTextAlign="Middle">
    <box leftPadding="4" rightPadding="4">
      <bottomPen lineWidth="0.25" lineColor="#E3E7ED"/>
    </box>
    <!-- Zebra striping: every second row gets a tinted background -->
    <conditionalStyle mode="Opaque" backcolor="#F5F7FA">
      <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
    </conditionalStyle>
  </style>

  <!-- ========================== Parameters ========================== -->
  <parameter name="BRAND_TEMPLATE" class="net.sf.jasperreports.engine.JRTemplate"/>
  <parameter name="TENANT_NAME" class="java.lang.String"/>
  <parameter name="TENANT_LOGO" class="net.sf.jasperreports.renderers.Renderable"/>
  <parameter name="FOOTER_TEXT" class="java.lang.String"/>
  <parameter name="CURRENCY_CODE" class="java.lang.String"/>
  <parameter name="CUSTOMER_NAME" class="java.lang.String"/>
  <parameter name="ADDRESS_LINE_1" class="java.lang.String"/>
  <parameter name="ADDRESS_LINE_2" class="java.lang.String"/>
  <parameter name="CITY" class="java.lang.String"/>
  <parameter name="POSTAL_CODE" class="java.lang.String"/>
  <parameter name="ACCOUNT_NO" class="java.lang.String"/>
  <parameter name="PRODUCT" class="java.lang.String"/>
  <parameter name="PERIOD_START" class="java.util.Date"/>
  <parameter name="PERIOD_END" class="java.util.Date"/>
  <parameter name="STATEMENT_DATE" class="java.util.Date"/>
  <parameter name="OPENING_BALANCE" class="java.math.BigDecimal">
    <defaultValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></defaultValueExpression>
  </parameter>

  <!-- ============ Fields (supplied by RunningBalanceDataSource) ============ -->
  <field name="postedOn" class="java.util.Date"/>
  <field name="description" class="java.lang.String"/>
  <field name="reference" class="java.lang.String"/>
  <field name="debit" class="java.math.BigDecimal"/>
  <field name="credit" class="java.math.BigDecimal"/>
  <field name="balanceBefore" class="java.math.BigDecimal"/>
  <field name="balance" class="java.math.BigDecimal"/>

  <!-- ========================== Variables ========================== -->
  <variable name="TotalCredits" class="java.math.BigDecimal" calculation="Sum">
    <expression><![CDATA[$F{credit} == null ? java.math.BigDecimal.ZERO : $F{credit}]]></expression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>
  <variable name="TotalDebits" class="java.math.BigDecimal" calculation="Sum">
    <expression><![CDATA[$F{debit} == null ? java.math.BigDecimal.ZERO : $F{debit}]]></expression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>

  <!-- ===================== Title (first page only) ===================== -->
  <title height="196">
    <element kind="image" x="0" y="0" width="150" height="44" scaleImage="RetainShape"
             hImageAlign="Left" vImageAlign="Middle" onErrorType="Blank">
      <printWhenExpression><![CDATA[$P{TENANT_LOGO} != null]]></printWhenExpression>
      <expression><![CDATA[$P{TENANT_LOGO}]]></expression>
    </element>
    <element kind="textField" x="160" y="0" width="363" height="26"
             style="Brand.Title" hTextAlign="Right">
      <expression><![CDATA[$P{TENANT_NAME}]]></expression>
    </element>
    <element kind="staticText" x="160" y="26" width="363" height="16"
             style="Muted" hTextAlign="Right">
      <text><![CDATA[ACCOUNT STATEMENT]]></text>
    </element>
    <element kind="line" x="0" y="52" width="523" height="1" style="Brand.Rule">
      <pen lineWidth="1.5"/>
    </element>

    <!-- Customer address block (left) -->
    <element kind="textField" x="0" y="64" width="270" height="14" bold="true" fontSize="10.0">
      <expression><![CDATA[$P{CUSTOMER_NAME}]]></expression>
    </element>
    <element kind="textField" x="0" y="80" width="270" height="12" blankWhenNull="true">
      <expression><![CDATA[$P{ADDRESS_LINE_1}]]></expression>
    </element>
    <element kind="textField" x="0" y="92" width="270" height="12" blankWhenNull="true">
      <expression><![CDATA[$P{ADDRESS_LINE_2}]]></expression>
    </element>
    <element kind="textField" x="0" y="104" width="270" height="12" blankWhenNull="true">
      <expression><![CDATA[($P{CITY} == null ? "" : $P{CITY}) + " "
          + ($P{POSTAL_CODE} == null ? "" : $P{POSTAL_CODE})]]></expression>
    </element>

    <!-- Statement details (right): label / value pairs -->
    <element kind="staticText" x="300" y="64" width="100" height="13" style="Muted">
      <text><![CDATA[Account number]]></text>
    </element>
    <element kind="textField" x="400" y="64" width="123" height="13" bold="true"
             hTextAlign="Right">
      <expression><![CDATA[$P{ACCOUNT_NO}]]></expression>
    </element>
    <element kind="staticText" x="300" y="77" width="100" height="13" style="Muted">
      <text><![CDATA[Account type]]></text>
    </element>
    <element kind="textField" x="400" y="77" width="123" height="13" hTextAlign="Right">
      <expression><![CDATA[$P{PRODUCT}]]></expression>
    </element>
    <element kind="staticText" x="300" y="90" width="100" height="13" style="Muted">
      <text><![CDATA[Period from]]></text>
    </element>
    <element kind="textField" x="400" y="90" width="123" height="13" hTextAlign="Right"
             pattern="d MMMM yyyy">
      <expression><![CDATA[$P{PERIOD_START}]]></expression>
    </element>
    <element kind="staticText" x="300" y="103" width="100" height="13" style="Muted">
      <text><![CDATA[Period to]]></text>
    </element>
    <element kind="textField" x="400" y="103" width="123" height="13" hTextAlign="Right"
             pattern="d MMMM yyyy">
      <expression><![CDATA[$P{PERIOD_END}]]></expression>
    </element>
    <element kind="staticText" x="300" y="116" width="100" height="13" style="Muted">
      <text><![CDATA[Statement date]]></text>
    </element>
    <element kind="textField" x="400" y="116" width="123" height="13" hTextAlign="Right"
             pattern="d MMMM yyyy">
      <expression><![CDATA[$P{STATEMENT_DATE}]]></expression>
    </element>

    <!-- Summary box. Totals and closing balance are only known after the last
         row, so those fields use evaluationTime="Report": JasperReports leaves
         a placeholder on page 1 and fills it in when the report ends. -->
    <element kind="frame" x="0" y="140" width="523" height="52">
      <box>
        <pen lineWidth="0.75" lineColor="#D5DBE3"/>
      </box>
      <element kind="textField" x="0" y="6" width="131" height="12" style="Muted">
        <box leftPadding="8"/>
        <expression><![CDATA["Opening balance (" + $P{CURRENCY_CODE} + ")"]]></expression>
      </element>
      <element kind="textField" x="0" y="20" width="131" height="24" style="Figure"
               pattern="#,##0.00">
        <box rightPadding="8"/>
        <expression><![CDATA[$P{OPENING_BALANCE}]]></expression>
      </element>

      <element kind="line" x="131" y="6" width="1" height="40" forecolor="#D5DBE3"/>
      <element kind="staticText" x="131" y="6" width="131" height="12" style="Muted">
        <box leftPadding="8"/>
        <text><![CDATA[Money in]]></text>
      </element>
      <element kind="textField" x="131" y="20" width="131" height="24" style="Figure"
               pattern="#,##0.00" evaluationTime="Report">
        <box rightPadding="8"/>
        <expression><![CDATA[$V{TotalCredits}]]></expression>
      </element>

      <element kind="line" x="262" y="6" width="1" height="40" forecolor="#D5DBE3"/>
      <element kind="staticText" x="262" y="6" width="131" height="12" style="Muted">
        <box leftPadding="8"/>
        <text><![CDATA[Money out]]></text>
      </element>
      <element kind="textField" x="262" y="20" width="131" height="24" style="Figure"
               pattern="#,##0.00" evaluationTime="Report">
        <box rightPadding="8"/>
        <expression><![CDATA[$V{TotalDebits}]]></expression>
      </element>

      <element kind="line" x="393" y="6" width="1" height="40" forecolor="#D5DBE3"/>
      <element kind="textField" x="393" y="6" width="130" height="12" style="Muted">
        <box leftPadding="8"/>
        <expression><![CDATA["Closing balance (" + $P{CURRENCY_CODE} + ")"]]></expression>
      </element>
      <element kind="textField" x="393" y="20" width="130" height="24" style="Brand.Accent"
               fontSize="11.0" hTextAlign="Right" pattern="#,##0.00" evaluationTime="Report">
        <box rightPadding="8"/>
        <expression><![CDATA[$P{OPENING_BALANCE}.add($V{TotalCredits})
            .subtract($V{TotalDebits})]]></expression>
      </element>
    </element>
  </title>

  <!-- ============= Page header (continuation pages only) ============= -->
  <pageHeader height="30">
    <!-- On page 1 the frame is hidden and removeLineWhenBlank collapses its space -->
    <element kind="frame" x="0" y="0" width="523" height="26" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
      <element kind="textField" x="0" y="6" width="300" height="14" bold="true"
               vTextAlign="Middle">
        <expression><![CDATA[$P{TENANT_NAME} + "  ·  " + $P{ACCOUNT_NO}]]></expression>
      </element>
      <element kind="staticText" x="300" y="6" width="133" height="14" style="Muted"
               hTextAlign="Right" vTextAlign="Middle">
        <text><![CDATA[Balance brought forward]]></text>
      </element>
      <!-- The page header is filled with the CURRENT row: the first row that
           will print on this page. Its balance-before is the brought-forward. -->
      <element kind="textField" x="433" y="6" width="90" height="14" bold="true"
               hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00">
        <box rightPadding="4"/>
        <expression><![CDATA[$F{balanceBefore}]]></expression>
      </element>
    </element>
  </pageHeader>

  <!-- ============== Column header (repeats on every page) ============== -->
  <columnHeader height="20">
    <element kind="staticText" x="0" y="0" width="60" height="20" style="Brand.BandFill"
             vTextAlign="Middle">
      <box leftPadding="4"/>
      <text><![CDATA[Date]]></text>
    </element>
    <element kind="staticText" x="60" y="0" width="203" height="20" style="Brand.BandFill"
             vTextAlign="Middle">
      <box leftPadding="4"/>
      <text><![CDATA[Description]]></text>
    </element>
    <element kind="staticText" x="263" y="0" width="80" height="20" style="Brand.BandFill"
             vTextAlign="Middle">
      <box leftPadding="4"/>
      <text><![CDATA[Reference]]></text>
    </element>
    <element kind="staticText" x="343" y="0" width="60" height="20" style="Brand.BandFill"
             hTextAlign="Right" vTextAlign="Middle">
      <box rightPadding="4"/>
      <text><![CDATA[Money out]]></text>
    </element>
    <element kind="staticText" x="403" y="0" width="60" height="20" style="Brand.BandFill"
             hTextAlign="Right" vTextAlign="Middle">
      <box rightPadding="4"/>
      <text><![CDATA[Money in]]></text>
    </element>
    <element kind="staticText" x="463" y="0" width="60" height="20" style="Brand.BandFill"
             hTextAlign="Right" vTextAlign="Middle">
      <box rightPadding="4"/>
      <text><![CDATA[Balance]]></text>
    </element>
  </columnHeader>

  <!-- ===================== Detail: one row per posting ===================== -->
  <detail>
    <band height="16">
      <element kind="textField" x="0" y="0" width="60" height="16" style="Cell"
               pattern="dd MMM yyyy" stretchType="ContainerHeight">
        <expression><![CDATA[$F{postedOn}]]></expression>
      </element>
      <!-- Long descriptions wrap; the other cells stretch to the same height
           so the zebra background and bottom rule stay continuous. -->
      <element kind="textField" x="60" y="0" width="203" height="16" style="Cell"
               textAdjust="StretchHeight">
        <expression><![CDATA[$F{description}]]></expression>
      </element>
      <element kind="textField" x="263" y="0" width="80" height="16" style="Cell"
               blankWhenNull="true" stretchType="ContainerHeight">
        <expression><![CDATA[$F{reference}]]></expression>
      </element>
      <element kind="textField" x="343" y="0" width="60" height="16" style="Cell"
               hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"
               stretchType="ContainerHeight">
        <expression><![CDATA[$F{debit}]]></expression>
      </element>
      <element kind="textField" x="403" y="0" width="60" height="16" style="Cell"
               hTextAlign="Right" pattern="#,##0.00" blankWhenNull="true"
               stretchType="ContainerHeight">
        <expression><![CDATA[$F{credit}]]></expression>
      </element>
      <element kind="textField" x="463" y="0" width="60" height="16" style="Cell"
               hTextAlign="Right" pattern="#,##0.00" bold="true"
               stretchType="ContainerHeight">
        <expression><![CDATA[$F{balance}]]></expression>
      </element>
    </band>
  </detail>

  <!-- ============ Page footer (every page except the last) ============ -->
  <pageFooter height="36">
    <element kind="line" x="0" y="0" width="523" height="1" style="Brand.Rule">
      <pen lineWidth="0.5"/>
    </element>
    <element kind="staticText" x="300" y="4" width="133" height="14" style="Muted"
             hTextAlign="Right" vTextAlign="Middle">
      <text><![CDATA[Balance carried forward]]></text>
    </element>
    <!-- When a page breaks inside the detail, the footer is filled with the
         PREVIOUS row's values: the last row printed on this page. -->
    <element kind="textField" x="433" y="4" width="90" height="14" bold="true"
             hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00">
      <box rightPadding="4"/>
      <expression><![CDATA[$F{balance}]]></expression>
    </element>
    <element kind="textField" x="0" y="20" width="400" height="14" style="Muted">
      <expression><![CDATA[$P{FOOTER_TEXT}]]></expression>
    </element>
    <element kind="textField" x="400" y="20" width="93" height="14" style="Muted"
             hTextAlign="Right">
      <expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></expression>
    </element>
    <element kind="textField" x="493" y="20" width="30" height="14" style="Muted"
             evaluationTime="Report">
      <expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
    </element>
  </pageFooter>

  <!-- ========= Last page footer replaces the page footer on the final page ========= -->
  <lastPageFooter height="36">
    <element kind="line" x="0" y="0" width="523" height="1" style="Brand.Rule">
      <pen lineWidth="0.5"/>
    </element>
    <element kind="staticText" x="300" y="4" width="133" height="14" style="Muted"
             hTextAlign="Right" vTextAlign="Middle">
      <text><![CDATA[Closing balance]]></text>
    </element>
    <element kind="textField" x="433" y="4" width="90" height="14" style="Brand.Accent"
             hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00">
      <box rightPadding="4"/>
      <expression><![CDATA[$P{OPENING_BALANCE}.add($V{TotalCredits})
          .subtract($V{TotalDebits})]]></expression>
    </element>
    <element kind="textField" x="0" y="20" width="400" height="14" style="Muted">
      <expression><![CDATA[$P{FOOTER_TEXT}]]></expression>
    </element>
    <element kind="textField" x="400" y="20" width="93" height="14" style="Muted"
             hTextAlign="Right">
      <expression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></expression>
    </element>
    <element kind="textField" x="493" y="20" width="30" height="14" style="Muted"
             evaluationTime="Report">
      <expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
    </element>
  </lastPageFooter>

  <!-- ================== Summary (after the last row) ================== -->
  <summary height="28">
    <element kind="staticText" x="0" y="8" width="523" height="14" style="Muted"
             hTextAlign="Center">
      <printWhenExpression><![CDATA[$V{REPORT_COUNT} == 0]]></printWhenExpression>
      <text><![CDATA[No transactions were posted to this account during the statement period.]]></text>
    </element>
    <element kind="staticText" x="0" y="8" width="523" height="14" style="Muted"
             hTextAlign="Center">
      <printWhenExpression><![CDATA[$V{REPORT_COUNT} > 0]]></printWhenExpression>
      <text><![CDATA[End of statement]]></text>
    </element>
  </summary>
</jasperReport>
