<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} %-5level [%thread] %logger{30} [%X{tenant}/%X{account}] %msg%n</pattern>
        </encoder>
    </appender>
    <!-- JasperReports is chatty at DEBUG; keep it quiet unless diagnosing a template -->
    <logger name="net.sf.jasperreports" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="software.amazon.awssdk" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>